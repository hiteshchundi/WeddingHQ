# Use a development/test database locally. Keep real credentials in .env.local.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/weddinghq_development?retryWrites=true&w=majority

# With Node.js 22.18+ and a configured development/test URI:
# NODE_ENV=development npm run db:smoke

# H2 organiser authentication. Keep real secrets only in ignored .env.local.
# Generate AUTH_SECRET with crypto.randomBytes(32) locally; never print/commit it.
AUTH_SECRET=
# Google Auth Platform: Web application, openid/email/profile only.
# Local authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Auth.js Resend provider uses this exact inferred key name (no Resend SDK).
AUTH_RESEND_KEY=
# An address on your verified Resend domain, e.g. Wedding HQ <signin@example.com>.
# For development only, onboarding@resend.dev can email the Resend account owner.
AUTH_EMAIL_FROM=
